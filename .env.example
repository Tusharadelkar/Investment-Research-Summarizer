# Choose one LLM provider. Groq is used first when multiple keys are present.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Set this only to a Groq model that accepts image inputs.
GROQ_VISION_MODEL=

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# VISION_MODEL=gpt-4o-mini

# OPENROUTER_API_KEY=
# OPENROUTER_API_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini

FLASK_SECRET_KEY=replace-with-a-random-secret
FLASK_DEBUG=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional: point this to the folder containing the saved cross-encoder model.
# RERANKER_MODEL=D:\CDAC PGCP AI\Module 7 - NLP\Investment_Research_Summarizer
CHUNK_SIZE=900
CHUNK_OVERLAP=150
